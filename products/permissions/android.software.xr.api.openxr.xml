<?xml version="1.0" encoding="utf-8"?>
<!--
  android.software.xr.api.openxr

  AOSP ships no XML for this feature at android-16.0.0_r4 - verified against
  frameworks/native/data/etc, 170 files, none matching. OpenXR 1.0 - version is the packed OpenXR API version.

  Declaring a feature makes PackageManager report it unconditionally. Only
  copy this into a product whose devices actually have the capability.
-->
<permissions>
    <feature name="android.software.xr.api.openxr" version="65536" />
</permissions>
