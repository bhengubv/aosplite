<?xml version="1.0" encoding="utf-8"?>
<!--
  android.software.live_wallpaper

  Live wallpapers. Declared by handheld product configs rather than frameworks.

  No XML in frameworks/native/data/etc declares this at android-16.0.0_r4,
  and no composite profile there does either - checked by indexing every
  <feature name=...> in all 170 files, not by filename.
-->
<permissions>
    <feature name="android.software.live_wallpaper" />
</permissions>
