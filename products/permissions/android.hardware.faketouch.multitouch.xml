<?xml version="1.0" encoding="utf-8"?>
<!--
  android.hardware.faketouch.multitouch

  AOSP ships no XML for this feature at android-16.0.0_r4 - verified against
  frameworks/native/data/etc, 170 files, none matching. Only the base faketouch feature ships upstream.

  Declaring a feature makes PackageManager report it unconditionally. Only
  copy this into a product whose devices actually have the capability.
-->
<permissions>
    <feature name="android.hardware.faketouch.multitouch" />
</permissions>
