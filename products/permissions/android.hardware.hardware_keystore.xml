<?xml version="1.0" encoding="utf-8"?>
<!--
  android.hardware.hardware_keystore

  Keystore backed by hardware. Version is the KeyMint/Keymaster version x100 - 100 means 1.0. A device with newer KeyMint should raise it.

  No XML in frameworks/native/data/etc declares this at android-16.0.0_r4,
  and no composite profile there does either - checked by indexing every
  <feature name=...> in all 170 files, not by filename.
-->
<permissions>
    <feature name="android.hardware.hardware_keystore" version="100" />
</permissions>
