<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tier 2 - Host toolchains for platforms you do not build on.

  AOSP ships prebuilt toolchains for Linux and macOS hosts, a Windows
  cross-compiler for producing Windows SDK tools, and the superseded
  JDK 8 alongside the JDK 21 the build actually uses.

  On a Linux builder producing a device image, the rest is inert.

  Not in this tier, and not to be added to it:
    prebuilts/clang/host/linux-x86   the compiler
    prebuilts/jdk/jdk21              the JDK the build uses
    prebuilts/go/linux-x86           Soong is written in Go
    prebuilts/build-tools            core build binaries
    prebuilts/rust                   large parts of the platform are Rust

  Verified against android-15.0.0_r20.

  Saving: ~12 GB
  Risk:   low
-->
<manifest>
  <remove-project name="platform/prebuilts/clang/host/darwin-x86" />
  <remove-project name="platform/prebuilts/go/darwin-x86" />
  <remove-project name="platform/prebuilts/bazel/darwin-x86_64" />
  <remove-project name="platform/prebuilts/jdk/jdk8" />

  <!-- Windows cross-compiler. Only needed to build Windows host tools
       (the Windows SDK). Not needed for a device image. -->
  <remove-project name="platform/prebuilts/gcc/linux-x86/host/x86_64-w64-mingw32-4.8" />
</manifest>
