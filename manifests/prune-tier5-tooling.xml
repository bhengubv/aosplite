<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tier 5 - App-development tooling, SDK packaging, samples, emulator.

  None of this is consumed by a platform build producing a device image.
  It is what you need in order to build applications, package an SDK, or
  run the emulator.

  Note on what is NOT here. Android Studio (tools/adt/idea, tools/base)
  and AndroidX (frameworks/support) are not in the AOSP platform
  manifest at all - they live in separate manifests. If you expected to
  cut them, they were never downloaded in the first place.

  platform/development is also deliberately absent. It holds host
  tooling that parts of the build reference, and removing it is a good
  way to produce a confusing failure.

  Verified against android-15.0.0_r20.

  Saving: ~8 GB
  Risk:   medium - if you build apps from this tree, some comes back
-->
<manifest>
  <!-- Sample code and SDK packaging -->
  <remove-project name="platform/developers/build" optional="true"/>
  <remove-project name="platform/developers/demos" optional="true"/>
  <remove-project name="platform/developers/samples/android" optional="true"/>
  <remove-project name="platform/sdk" optional="true"/>

  <!-- Emulator. Remove only if you boot-test on hardware or Cuttlefish. -->
  <remove-project name="platform/prebuilts/android-emulator" optional="true"/>
  <remove-project name="platform/prebuilts/qemu-kernel" optional="true"/>

  <!-- App-build tooling -->
  <remove-project name="platform/prebuilts/ndk" optional="true"/>
  <!-- NOT pruned: defines metalava-gradle-plugin-deps, which tools/metalava
       lists in its dependencies. metalava is already on the do-not-cut
       list, so cutting what it needs fails the same way:
         module metalava missing dependencies: metalava-gradle-plugin-deps
       Surfaces at build time rather than analysis, because a pruned tree
       sets ALLOW_MISSING_DEPENDENCIES.
  <remove-project name="platform/prebuilts/gradle-plugin" optional="true"/>
  -->
  <!-- NOT pruned: glide-prebuilt, glide-gifdecoder-prebuilt and
       glide-disklrucache-prebuilt are used by packages/apps/DocumentsUI
       and packages/apps/WallpaperPicker2, both of which ship in a system
       image. Found by tools/check-modules.sh before it broke a build.
  <remove-project name="platform/prebuilts/maven_repo/bumptech" optional="true"/>
  -->
  <!-- NOT pruned: defines lint_api, which tools/lint_checks and the lint
       directories under packages/modules/* depend on.
  <remove-project name="platform/prebuilts/cmdline-tools" optional="true"/>
  -->
  <remove-project name="platform/prebuilts/devtools" optional="true"/>

  <!-- Java linters. Not run by a platform build. -->
  <remove-project name="platform/prebuilts/checkstyle" optional="true"/>
  <remove-project name="platform/prebuilts/checkcolor" optional="true"/>
  <remove-project name="platform/prebuilts/ktlint" optional="true"/>
</manifest>
